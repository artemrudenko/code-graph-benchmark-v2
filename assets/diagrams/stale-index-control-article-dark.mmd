flowchart TB
    A[Index says:<br/>4 direct callers] --> B[Source changes:<br/>5 direct callers]
    B --> C[Old graph misses<br/>the new caller]
    C --> D{Index revision<br/>and scope match?}
    D -- No or unknown --> E[Check current source<br/>for the complete caller set]
    E --> F[Refresh index<br/>and record revision]
    D -- Yes --> G[Use index to navigate;<br/>verify change-sensitive edges]
    F --> G

    classDef index fill:#102D3A,stroke:#A9DDE7,color:#F0EDE4,stroke-width:2px;
    classDef change fill:#332B1D,stroke:#F3C969,color:#F0EDE4,stroke-width:2px;
    classDef risk fill:#332126,stroke:#F26B5B,color:#F0EDE4,stroke-width:2px;
    classDef verify fill:#153329,stroke:#62D2C3,color:#F0EDE4,stroke-width:2px;
    class A index;
    class B,D change;
    class C risk;
    class E,F,G verify;
